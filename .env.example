# Copia este archivo como .env y coloca tus valores reales.
# El archivo .env esta en .gitignore: NUNCA lo subas al repositorio.

# API REST interna (cabecera Authorization)
API_KEY=

# Sal de crypt() para contrasenas (debe ser la misma que se uso al crear
# los usuarios existentes, o sus contrasenas dejaran de funcionar)
APP_SALT=

# Firma de los tokens JWT
JWT_SECRET=

# Google Sign-In
GOOGLE_CLIENT_ID=

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# dLocal Go
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
